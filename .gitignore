# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# 数据目录：排除内容而非目录本身，否则下面的例外规则不会生效
data/*
logs/

# 备份目录例外 —— Parquet 压缩后体积小，可进 git 用于跨设备同步
!data/backup/

# IDE
.vscode/
.idea/
*.swp

# macOS
.DS_Store

# 虚拟环境
venv/
.venv/
env/

# Claude worktrees
.claude/worktrees/

# OpenD 安装包（二进制，不入库）
opend/
FutuOpenD/
*.dmg
*.exe
*.msi

# 本地配置（账号密码等敏感信息）
config/local.yaml

# 临时文件
temp/
*.tmp
